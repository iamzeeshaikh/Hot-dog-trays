---
// Font Awesome, subset to the 81 icons this site renders — see
// scripts/build-fa-subset.mjs. The full package was 27KB of render-blocking
// CSS (86% unused) plus 231KB of webfont on every page with an icon.
import '../styles/fontawesome-subset.css';
import '../styles/global.css';

import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import favicon from '../assets/site/favicon.png';

import WhatsAppButton from '../components/WhatsAppButton.astro';
export interface Props {
  title: string;
  description?: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  schema?: unknown;
}

const { title, description, path, ogImage, ogType, noindex, schema } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="gi7tj-kivAVV3-SnW_HAnmWGf2gbiGuADDz7STugsqY" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google tag (gtag.js) -->
    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-N3HYCBHC8Y"></script>
    <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-N3HYCBHC8Y');</script>
    <link rel="icon" type="image/png" href={favicon.src} />
    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    {schema && <JsonLd data={schema} />}
    <slot name="head" />
  </head>
  <body>
    <a class="hdt-skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {/* ZeeOps live chat, deferred to the first interaction (or 6s after load)
        so its 23KB and its site-config request never compete with the page's
        own LCP. See public/chat-loader.js. Conversations land in the dashboard
        at chat.zeeops.dev under the `hotdogtrays` site. */}
    <script src="/chat-loader.js" defer></script>
      <WhatsAppButton />
  </body>
</html>
