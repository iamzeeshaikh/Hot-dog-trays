---
import ProductCard from './ProductCard.astro';
import type { Product } from '../data/products';

export interface Props {
  products: Product[];
  label: string;
}
const { products, label } = Astro.props;
---

<ul class="hdt-product-grid" aria-label={label}>
  {products.map((p, i) => <ProductCard product={p} eager={i < 4} />)}
</ul>

<style>
  .hdt-product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1024px) {
    .hdt-product-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .hdt-product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 400px) {
    .hdt-product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
