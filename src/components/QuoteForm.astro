---
import { products } from '../data/products';

/**
 * Site-wide "Request Your Quote" panel, migrated from the Elementor quote-form
 * widget used on the homepage, About, Contact, FAQ and Get Quote pages.
 *
 * Changes from the source widget:
 *  - posts to the server-side /api/quote/ endpoint instead of send-quote.php;
 *  - the product list is generated from the catalogue (the original hard-coded
 *    nine options, two of which matched no real product);
 *  - adds a honeypot, an accessible live region and the submitting page URL.
 */
export interface Props {
  /** Pre-selects a product, used on product pages. */
  selectedProduct?: string;
  /** Unique suffix so several forms can never share DOM ids. */
  idPrefix?: string;
}

const { selectedProduct = '', idPrefix = 'quote' } = Astro.props;

const id = (name: string) => `${idPrefix}-${name}`;

const quantities = [
  ['100-500', '100 - 500 units'],
  ['500-1000', '500 - 1,000 units'],
  ['1000-5000', '1,000 - 5,000 units'],
  ['5000-10000', '5,000 - 10,000 units'],
  ['10000+', '10,000+ units'],
];

const materials = ['Paper', 'Cardboard', 'Kraft Paper', 'Plastic', 'Corrugated', 'Not Sure'];

const printingOptions = [
  'Yes - Custom Design',
  'Yes - I Have Design',
  'No - Plain Trays',
  'Not Sure',
];
---

<div class="hdt-quote-form">
  <h3 class="hdt-form-title">Request Your Quote</h3>
  <p class="hdt-form-subtitle">All fields marked with * are required</p>

  <div
    id={id('message')}
    class="hdt-form-message"
    role="status"
    aria-live="polite"
    data-form-message
  >
  </div>

  <form id={id('form')} method="POST" action="/api/quote/" data-quote-form novalidate>
    <input type="hidden" name="kind" value="quote" />
    <input type="hidden" name="pageUrl" data-page-url value="" />

    <div class="hdt-form-row">
      <div class="hdt-form-group">
        <label for={id('name')}>Your Name <span class="required">*</span></label>
        <input
          type="text"
          id={id('name')}
          name="name"
          class="hdt-form-input"
          placeholder="John Smith"
          autocomplete="name"
          maxlength="120"
          required
        />
      </div>

      <div class="hdt-form-group">
        <label for={id('email')}>Email Address <span class="required">*</span></label>
        <input
          type="email"
          id={id('email')}
          name="email"
          class="hdt-form-input"
          placeholder="john@company.com"
          autocomplete="email"
          maxlength="200"
          required
        />
      </div>
    </div>

    <div class="hdt-form-row">
      <div class="hdt-form-group">
        <label for={id('phone')}>Phone Number <span class="required">*</span></label>
        <input
          type="tel"
          id={id('phone')}
          name="phone"
          class="hdt-form-input"
          placeholder="(503) 358-0443"
          autocomplete="tel"
          maxlength="40"
          required
        />
      </div>

      <div class="hdt-form-group">
        <label for={id('company')}>Company Name</label>
        <input
          type="text"
          id={id('company')}
          name="company"
          class="hdt-form-input"
          placeholder="Your Business"
          autocomplete="organization"
          maxlength="120"
        />
      </div>
    </div>

    <div class="hdt-form-row">
      <div class="hdt-form-group">
        <label for={id('product')}>Product Type <span class="required">*</span></label>
        <select id={id('product')} name="product" class="hdt-form-select" required>
          <option value="">Select product type</option>
          {
            products.map((p) => (
              <option value={p.name} selected={p.name === selectedProduct}>
                {p.name}
              </option>
            ))
          }
          <option value="Other" selected={selectedProduct === 'Other'}>Other</option>
        </select>
      </div>

      <div class="hdt-form-group">
        <label for={id('quantity')}>Estimated Quantity <span class="required">*</span></label>
        <select id={id('quantity')} name="quantity" class="hdt-form-select" required>
          <option value="">Select quantity</option>
          {quantities.map(([v, l]) => <option value={v}>{l}</option>)}
        </select>
      </div>
    </div>

    <div class="hdt-form-row">
      <div class="hdt-form-group">
        <label for={id('material')}>Preferred Material</label>
        <select id={id('material')} name="material" class="hdt-form-select">
          <option value="">Select material</option>
          {materials.map((m) => <option value={m}>{m}</option>)}
        </select>
      </div>

      <div class="hdt-form-group">
        <label for={id('printing')}>Printing Required?</label>
        <select id={id('printing')} name="printing" class="hdt-form-select">
          <option value="">Select option</option>
          {printingOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
    </div>

    <div class="hdt-form-group">
      <label for={id('details')}>Project Details</label>
      <textarea
        id={id('details')}
        name="details"
        class="hdt-form-textarea"
        maxlength="5000"
        placeholder="Tell us about your project, timeline, special requirements, etc."></textarea>
    </div>

    <div class="hdt-hp" aria-hidden="true">
      <label for={id('website')}>Website</label>
      <input type="text" id={id('website')} name="website_hp" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" class="hdt-form-submit">Get My Free Quote</button>

    <div class="hdt-form-privacy">
      Your information is secure and will never be shared. Read our
      <a href="/privacy-policy/">Privacy Policy</a>.
    </div>
  </form>
</div>

<script>
  import { wireQuoteForm } from '../scripts/quote-form';
  document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach(wireQuoteForm);
</script>

<style>
/* Migrated from the Elementor "QuoteFormPanel" HTML widget. */
/* Force everything clickable */
.hdt-quote-form,
.hdt-quote-form * {
    pointer-events: auto !important;
}

.hdt-quote-form input,
.hdt-quote-form select,
.hdt-quote-form textarea,
.hdt-quote-form button {
    cursor: pointer !important;
}

/* Quote Form */
.hdt-quote-form {
    background: white;
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    height: 100%;
}

.hdt-form-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: #1D3557;
    margin-bottom: 10px;
    text-align: center;
}

.hdt-form-subtitle {
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 30px;
    text-align: center;
}

/* Form Row */
.hdt-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

/* Form Group */
.hdt-form-group {
    margin-bottom: 20px;
}

.hdt-form-group label {
    display: block;
    font-weight: 700;
    color: #1D3557;
    margin-bottom: 8px;
    font-size: 0.9rem;
}

.hdt-form-group label .required {
    color: #E63946;
}

.hdt-form-input,
.hdt-form-select,
.hdt-form-textarea {
    width: 100%;
    padding: 14px 18px;
    border: 2px solid #E5E5E5;
    border-radius: 10px;
    font-size: 1rem;
    transition: all 0.3s;
    background: white;
    font-family: inherit;
}

.hdt-form-input:focus,
.hdt-form-select:focus,
.hdt-form-textarea:focus {
    outline: none;
    border-color: #F9C74F;
    box-shadow: 0 0 0 3px rgba(249, 199, 79, 0.1);
}

.hdt-form-textarea {
    resize: vertical;
    min-height: 120px;
}

/* Submit Button */
.hdt-form-submit {
    width: 100%;
    padding: 18px;
    background: linear-gradient(135deg, #F9C74F, #E63946);
    color: #1D3557;
    border: none;
    border-radius: 50px;
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 8px 20px rgba(249, 199, 79, 0.4);
}

.hdt-form-submit:hover {
    background: linear-gradient(135deg, #E63946, #F9C74F);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(230, 57, 70, 0.5);
}

.hdt-form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

/* Messages */
.hdt-form-message {
    padding: 15px 20px;
    border-radius: 10px;
    margin-bottom: 20px;
    font-weight: 600;
    display: none;
}

.hdt-form-message.success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
    display: block;
}

.hdt-form-message.error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
    display: block;
}

/* Privacy Notice */
.hdt-form-privacy {
    font-size: 0.85rem;
    color: #666;
    margin-top: 15px;
    text-align: center;
}

.hdt-form-privacy a {
    color: #C92A35;
    text-decoration: none;
}

.hdt-form-privacy a:hover {
    text-decoration: underline;
}

/* Responsive */
@media (max-width: 768px) {
    .hdt-quote-form {
        padding: 30px 20px;
    }
    
    .hdt-form-title {
        font-size: 1.5rem;
    }
    
    .hdt-form-row {
        grid-template-columns: 1fr;
    }
}

/* --- migration additions --------------------------------------------------
   The original toggled .success/.error classes; the migrated form uses a
   data-state attribute driven by the real endpoint response. */
.hdt-form-message.is-visible {
    display: block;
}

.hdt-form-message[data-state="success"] {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
}

.hdt-form-message[data-state="error"] {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
}

.hdt-form-message[data-state="pending"] {
    background: #f1f1f1;
    color: #444;
    border: 1px solid #e0e0e0;
}

.hdt-quote-form [aria-invalid="true"] {
    border-color: #e63946 !important;
}

.hdt-form-submit:disabled {
    opacity: 0.65;
    cursor: progress;
    transform: none;
}

/* honeypot: off-screen rather than display:none so bots still fill it */
.hdt-quote-form .hdt-hp {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}
</style>
