---
import { Image } from 'astro:assets';
import imgCardboardhotdogholderswholesale from '../../assets/products/Cardboard-hot-dog-holders-wholesale.jpg';
import imgHotDogPaperHoldersInBulk from '../../assets/products/Hot-Dog-Paper-Holders-In-Bulk.jpg';
import imgHotdogservingtraywithlid from '../../assets/products/Hot-dog-serving-tray-with-lid.jpg';
import imgPaperFoodTrays from '../../assets/products/Paper-Food-Trays.jpg';
---

<section class="hdt-material-options">
    <div class="hdt-material-container">
        <div class="hdt-material-header">
            <div class="hdt-material-badge">Choose Your Material</div>
            <h2 class="hdt-material-title">Available Material Options</h2>
            <p class="hdt-material-subtitle">
                Select the perfect material for your hot dog trays. All options are food-safe and available with custom printing.
            </p>
        </div>
        <div class="hdt-material-grid">
            <div class="hdt-material-card">
                <input type="radio" name="material" id="material-kraft" class="hdt-material-input" value="kraft">
                <label for="material-kraft" class="hdt-material-label">
                    <div class="hdt-material-image">
                         <Image src={imgHotDogPaperHoldersInBulk} alt="Kraft Paper" widths={[400, 800]} sizes="(max-width: 768px) 92vw, (max-width: 1200px) 45vw, 300px" loading="lazy" decoding="async" /> 
                        <div class="hdt-material-badge-selected">✓ Selected</div>
                    </div>
                    <div class="hdt-material-content">
                        <div class="hdt-material-name">
                            <span>Kraft Paper</span>
                            <div class="hdt-material-icon">♻️</div>
                        </div>
                        <p class="hdt-material-description">
                            Natural, eco-friendly kraft paper with rustic brown finish. Perfect for organic and eco-conscious brands.
                        </p>
                        <div class="hdt-material-features">
                            <div class="hdt-material-feature">100% recyclable & biodegradable</div>
                            <div class="hdt-material-feature">FSC-certified sustainable sourcing</div>
                            <div class="hdt-material-feature">Natural rustic appearance</div>
                            <div class="hdt-material-feature">250gsm thickness (durable)</div>
                        </div>
                        <div class="hdt-material-footer">
                            <div class="hdt-material-price">
                                <span class="hdt-material-price-label">Starting at</span>
                                <span class="hdt-material-price-amount">$0.70<span class="hdt-material-price-unit">/ea</span></span>
                            </div>
                            <button type="button" class="hdt-material-select-btn">Select</button>
                        </div>
                    </div>
                </label>
            </div>
            <div class="hdt-material-card">
                <input type="radio" name="material" id="material-cardboard" class="hdt-material-input" value="cardboard">
                <label for="material-cardboard" class="hdt-material-label">
                    <div class="hdt-material-image">
                        <Image src={imgCardboardhotdogholderswholesale} alt="White Cardboard" widths={[400, 800]} sizes="(max-width: 768px) 92vw, (max-width: 1200px) 45vw, 300px" loading="lazy" decoding="async" /> 
                        <div class="hdt-material-badge-selected">✓ Selected</div>
                    </div>
                    <div class="hdt-material-content">
                        <div class="hdt-material-name">
                            <span>Cardboard</span>
                            <div class="hdt-material-icon">🎨</div>
                        </div>
                        <p class="hdt-material-description">
                            Premium white cardboard with smooth surface. Ideal for vibrant full-color printing and professional branding.
                        </p>
                        <div class="hdt-material-features">
                            <div class="hdt-material-feature">Bright white finish for vivid colors</div>
                            <div class="hdt-material-feature">Excellent print quality</div>
                            <div class="hdt-material-feature">Strong & rigid construction</div>
                            <div class="hdt-material-feature">300gsm thickness (extra sturdy)</div>
                        </div>
                        <div class="hdt-material-footer">
                            <div class="hdt-material-price">
                                <span class="hdt-material-price-label">Starting at</span>
                                <span class="hdt-material-price-amount">$0.75<span class="hdt-material-price-unit">/ea</span></span>
                            </div>
                            <button type="button" class="hdt-material-select-btn">Select</button>
                        </div>
                    </div>
                </label>
            </div>
            <div class="hdt-material-card">
                <input type="radio" name="material" id="material-corrugated" class="hdt-material-input" value="corrugated">
                <label for="material-corrugated" class="hdt-material-label">
                    <div class="hdt-material-image">
                         <Image src={imgHotdogservingtraywithlid} alt="Corrugated" widths={[400, 800]} sizes="(max-width: 768px) 92vw, (max-width: 1200px) 45vw, 300px" loading="lazy" decoding="async" /> 
                        <div class="hdt-material-badge-selected">✓ Selected</div>
                    </div>
                    <div class="hdt-material-content">
                        <div class="hdt-material-name">
                            <span>Corrugated</span>
                            <div class="hdt-material-icon">💪</div>
                        </div>
                        <p class="hdt-material-description">
                            Extra-thick corrugated material with superior insulation. Best for hot foods and heavy-duty applications.
                        </p>
                        <div class="hdt-material-features">
                            <div class="hdt-material-feature">Maximum durability & strength</div>
                            <div class="hdt-material-feature">Excellent heat insulation</div>
                            <div class="hdt-material-feature">Prevents oil seepage</div>
                            <div class="hdt-material-feature">350gsm thickness (premium)</div>
                        </div>
                        <div class="hdt-material-footer">
                            <div class="hdt-material-price">
                                <span class="hdt-material-price-label">Starting at</span>
                                <span class="hdt-material-price-amount">$0.85<span class="hdt-material-price-unit">/ea</span></span>
                            </div>
                            <button type="button" class="hdt-material-select-btn">Select</button>
                        </div>
                    </div>
                </label>
            </div>
            <div class="hdt-material-card">
                <input type="radio" name="material" id="material-plastic" class="hdt-material-input" value="plastic">
                <label for="material-plastic" class="hdt-material-label">
                    <div class="hdt-material-image">
                       <Image src={imgPaperFoodTrays} alt="Plastic" widths={[400, 800]} sizes="(max-width: 768px) 92vw, (max-width: 1200px) 45vw, 300px" loading="lazy" decoding="async" /> 
                        <div class="hdt-material-badge-selected">✓ Selected</div>
                    </div>
                    <div class="hdt-material-content">
                        <div class="hdt-material-name">
                            <span>Food-Safe Plastic</span>
                            <div class="hdt-material-icon">✨</div>
                        </div>
                        <p class="hdt-material-description">
                            Durable food-grade plastic that's reusable and easy to clean. Perfect for high-volume operations.
                        </p>
                        <div class="hdt-material-features">
                            <div class="hdt-material-feature">Reusable & dishwasher safe</div>
                            <div class="hdt-material-feature">BPA-free, FDA approved</div>
                            <div class="hdt-material-feature">Clear or colored options</div>
                            <div class="hdt-material-feature">Microwave safe (up to 3 min)</div>
                        </div>
                        <div class="hdt-material-footer">
                            <div class="hdt-material-price">
                                <span class="hdt-material-price-label">Starting at</span>
                                <span class="hdt-material-price-amount">$0.95<span class="hdt-material-price-unit">/ea</span></span>
                            </div>
                            <button type="button" class="hdt-material-select-btn">Select</button>
                        </div>
                    </div>
                </label>
            </div>
        </div>
        <div class="hdt-material-comparison">
            <h3 class="hdt-comparison-title">Material Comparison Guide</h3>
            <div class="hdt-comparison-table">
                <table class="hdt-comparison">
                    <thead>
                        <tr>
                            <th>Feature</th>
                            <th>Kraft Paper</th>
                            <th>White Cardboard</th>
                            <th>Corrugated</th>
                            <th>Plastic</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Eco-Friendly</td>
                            <td><span class="hdt-comparison-check">✓✓✓</span></td>
                            <td><span class="hdt-comparison-check">✓✓</span></td>
                            <td><span class="hdt-comparison-check">✓✓</span></td>
                            <td><span class="hdt-comparison-cross">✗</span></td>
                        </tr>
                        <tr>
                            <td>Print Quality</td>
                            <td>Good</td>
                            <td><strong>Excellent</strong></td>
                            <td>Good</td>
                            <td>Limited</td>
                        </tr>
                        <tr>
                            <td>Durability</td>
                            <td>Good</td>
                            <td>Very Good</td>
                            <td><strong>Excellent</strong></td>
                            <td><strong>Excellent</strong></td>
                        </tr>
                        <tr>
                            <td>Heat Resistance</td>
                            <td>Good (up to 180°F)</td>
                            <td>Good (up to 180°F)</td>
                            <td><strong>Excellent (up to 200°F)</strong></td>
                            <td>Moderate (up to 140°F)</td>
                        </tr>
                        <tr>
                            <td>Reusable</td>
                            <td><span class="hdt-comparison-cross">✗</span></td>
                            <td><span class="hdt-comparison-cross">✗</span></td>
                            <td><span class="hdt-comparison-cross">✗</span></td>
                            <td><span class="hdt-comparison-check">✓✓✓</span></td>
                        </tr>
                        <tr>
                            <td>Cost Effective</td>
                            <td><strong>Most Affordable</strong></td>
                            <td>Moderate</td>
                            <td>Moderate</td>
                            <td>Higher Initial Cost</td>
                        </tr>
                        <tr>
                            <td>Best For</td>
                            <td>Eco-conscious brands</td>
                            <td>Premium branding</td>
                            <td>Hot & heavy foods</td>
                            <td>High-volume ops</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script>
  import { wireMaterialSelect } from '../../scripts/material-select';
  wireMaterialSelect();
</script>

<style>
/* Migrated from the Elementor "MaterialOptions" HTML widget. */
/* Force everything clickable */
.hdt-material-options,
.hdt-material-options * {
    pointer-events: auto !important;
}

.hdt-material-options input,
.hdt-material-options label {
    cursor: pointer !important;
}

/* Material Options Section */
.hdt-material-options {
    background: linear-gradient(180deg, #F1FAEE 0%, #FFFFFF 100%);
    padding: 80px 0;
}

.hdt-material-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Section Header */
.hdt-material-header {
    text-align: center;
    margin-bottom: 50px;
}

.hdt-material-badge {
    display: inline-block;
    background: linear-gradient(135deg, #F9C74F, #E63946);
    color: #1D3557;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.hdt-material-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: #1D3557;
    margin-bottom: 15px;
    line-height: 1.2;
}

.hdt-material-subtitle {
    font-size: 1.1rem;
    color: #666;
    max-width: 650px;
    margin: 0 auto;
}

/* Material Cards Grid */
.hdt-material-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-bottom: 50px;
}

/* Material Card */
.hdt-material-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    position: relative;
    border: 3px solid transparent;
}

.hdt-material-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(230, 57, 70, 0.2);
    border-color: #F9C74F;
}

/* Radio Input (Hidden) */
.hdt-material-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.hdt-material-input:checked + .hdt-material-label {
    border-color: #E63946;
    box-shadow: 0 15px 40px rgba(230, 57, 70, 0.3);
}

.hdt-material-input:checked + .hdt-material-label .hdt-material-badge-selected {
    opacity: 1;
    transform: scale(1);
}

/* Material Label */
.hdt-material-label {
    display: block;
    cursor: pointer;
    border: 3px solid transparent;
    border-radius: 20px;
    transition: all 0.3s;
}

/* Material Image */
.hdt-material-image {
    width: 100%;
    height: 220px;
    background: linear-gradient(135deg, #F1FAEE, #FFFFFF);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.hdt-material-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hdt-material-image-placeholder {
    font-size: 5rem;
}

/* Selected Badge */
.hdt-material-badge-selected {
    position: absolute;
    top: 15px;
    right: 15px;
    background: linear-gradient(135deg, #E63946, #F9C74F);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.3s;
    box-shadow: 0 5px 15px rgba(230, 57, 70, 0.4);
}

/* Material Content */
.hdt-material-content {
    padding: 30px 25px;
}

.hdt-material-name {
    font-size: 1.6rem;
    font-weight: 800;
    color: #1D3557;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.hdt-material-icon {
    width: 45px;
    height: 45px;
    background: linear-gradient(135deg, #F9C74F, #E63946);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    box-shadow: 0 5px 15px rgba(249, 199, 79, 0.4);
}

.hdt-material-description {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.7;
    margin-bottom: 20px;
}

/* Material Features */
.hdt-material-features {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
}

.hdt-material-feature {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: #1D3557;
}

.hdt-material-feature::before {
    content: '✓';
    width: 22px;
    height: 22px;
    background: rgba(249, 199, 79, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #E63946;
    font-weight: 900;
    font-size: 0.85rem;
}

/* Material Footer */
.hdt-material-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    border-top: 2px solid #F1FAEE;
}

.hdt-material-price {
    display: flex;
    flex-direction: column;
}

.hdt-material-price-label {
    font-size: 0.75rem;
    color: #666;
    text-transform: uppercase;
    margin-bottom: 3px;
}

.hdt-material-price-amount {
    font-size: 1.8rem;
    font-weight: 900;
    color: #E63946;
    line-height: 1;
}

.hdt-material-price-unit {
    font-size: 0.9rem;
    color: #666;
    font-weight: 600;
}

.hdt-material-select-btn {
    padding: 12px 25px;
    background: linear-gradient(135deg, #F9C74F, #E63946);
    color: #1D3557;
    border: none;
    border-radius: 50px;
    font-weight: 800;
    font-size: 0.9rem;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 5px 15px rgba(249, 199, 79, 0.4);
}

.hdt-material-select-btn:hover {
    background: linear-gradient(135deg, #E63946, #F9C74F);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(230, 57, 70, 0.5);
}

/* Comparison Table */
.hdt-material-comparison {
    background: white;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
}

.hdt-comparison-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: #1D3557;
    margin-bottom: 30px;
    text-align: center;
}

.hdt-comparison-table {
    width: 100%;
    overflow-x: auto;
}

table.hdt-comparison {
    width: 100%;
    border-collapse: collapse;
}

.hdt-comparison thead {
    background: linear-gradient(135deg, #1D3557, #2A4A6F);
}

.hdt-comparison thead th {
    padding: 20px 15px;
    color: white;
    font-weight: 800;
    text-align: left;
    font-size: 1rem;
}

.hdt-comparison thead th:first-child {
    border-radius: 15px 0 0 0;
}

.hdt-comparison thead th:last-child {
    border-radius: 0 15px 0 0;
}

.hdt-comparison tbody tr {
    border-bottom: 2px solid #F1FAEE;
}

.hdt-comparison tbody tr:last-child {
    border-bottom: none;
}

.hdt-comparison tbody td {
    padding: 18px 15px;
    font-size: 0.95rem;
}

.hdt-comparison tbody td:first-child {
    font-weight: 800;
    color: #1D3557;
}

.hdt-comparison tbody td {
    color: #666;
}

.hdt-comparison-check {
    color: #2A9D8F;
    font-weight: 900;
    font-size: 1.2rem;
}

.hdt-comparison-cross {
    color: #E63946;
    font-weight: 900;
    font-size: 1.2rem;
}

/* Responsive Design */
@media (max-width: 1024px) {
    .hdt-material-grid {
        gap: 25px;
    }
}

@media (max-width: 768px) {
    .hdt-material-options {
        padding: 60px 0;
    }
    
    .hdt-material-title {
        font-size: 2rem;
    }
    
    .hdt-material-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }
    
    .hdt-material-comparison {
        padding: 25px 20px;
    }
    
    .hdt-comparison-table {
        overflow-x: scroll;
    }
}

@media (max-width: 480px) {
    .hdt-material-title {
        font-size: 1.7rem;
    }
    
    .hdt-material-content {
        padding: 25px 20px;
    }
    
    .hdt-material-name {
        font-size: 1.4rem;
    }
    
    .hdt-material-footer {
        flex-direction: column;
        gap: 15px;
        align-items: flex-start;
    }
    
    .hdt-material-select-btn {
        width: 100%;
    }
}

/* Performance Optimization */
@media (prefers-reduced-motion: reduce) {
    .hdt-material-card,
    .hdt-material-badge-selected,
    .hdt-material-select-btn {
        transition: none !important;
    }
}

/* --- migration additions --------------------------------------------------
   The bar chart's fixed label column pushed past the card on narrow screens. */
.hdt-comparison-bars {
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
}
</style>
