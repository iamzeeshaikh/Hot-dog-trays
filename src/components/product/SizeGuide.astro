<script>
  interface SizeSpec {
    length: string;
    width: string;
    depth: string;
    weight: string;
    hotdogs: string;
    toppings: string;
    volume: string;
    maxWeight: string;
    bestFor: string;
  }

  const sizeData: Record<string, SizeSpec> = {
    small: {
      length: '6 inches',
      width: '2 inches',
      depth: '1 inch',
      weight: '8g',
      hotdogs: '1',
      toppings: '2-3',
      volume: '80ml',
      maxWeight: '150g',
      bestFor:
        'Mini hot dogs, appetizers, kids meals. Perfect for catering and party platters.',
    },
    medium: {
      length: '8 inches',
      width: '2.5 inches',
      depth: '1.5 inches',
      weight: '12g',
      hotdogs: '1',
      toppings: '3-4',
      volume: '120ml',
      maxWeight: '200g',
      bestFor:
        'Standard hot dogs, sausages, bratwurst. Perfect for food trucks, stadiums, and casual dining.',
    },
    large: {
      length: '10 inches',
      width: '3 inches',
      depth: '2 inches',
      weight: '15g',
      hotdogs: '1-2',
      toppings: '4-5',
      volume: '180ml',
      maxWeight: '250g',
      bestFor:
        'Jumbo hot dogs, foot-longs, loaded dogs. Ideal for premium offerings and specialty items.',
    },
    xlarge: {
      length: '12 inches',
      width: '3.5 inches',
      depth: '2.5 inches',
      weight: '18g',
      hotdogs: '2',
      toppings: '5-6',
      volume: '250ml',
      maxWeight: '300g',
      bestFor:
        'Foot-long hot dogs, multiple items, family servings. Great for high-volume operations.',
    },
  };

  function setText(id: string, value: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  function updateSizeDisplay(size: string) {
    const data = sizeData[size];
    if (!data) return;

    setText('dim-length', data.length);
    setText('dim-width', data.width);
    setText('dim-depth', `${data.depth} deep`);

    setText('spec-length', data.length);
    setText('spec-width', data.width);
    setText('spec-depth', data.depth);
    setText('spec-weight', data.weight);

    setText('capacity-hotdogs', data.hotdogs);
    setText('capacity-toppings', data.toppings);
    setText('capacity-volume', data.volume);
    setText('capacity-weight', data.maxWeight);

    setText('best-for-text', data.bestFor);
  }

  const radios = document.querySelectorAll<HTMLInputElement>('.hdt-size-radio');
  radios.forEach((radio) => {
    radio.addEventListener('change', () => {
      if (radio.checked) updateSizeDisplay(radio.value);
    });
  });

  updateSizeDisplay(
    Array.from(radios).find((r) => r.checked)?.value ?? 'medium',
  );
</script>

