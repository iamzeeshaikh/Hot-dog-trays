<script>
  import { wireFaqAccordions } from '../../scripts/faq-accordion';

  wireFaqAccordions();

  // Client-side filter over the FAQ list. Matching entries are revealed and, for
  // a specific enough query, expanded; a cleared field restores the full list.
  const search = document.getElementById('faqSearch') as HTMLInputElement | null;
  const button = document.getElementById('faqSearchBtn');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.hdt-faq-item'));
  const status = document.getElementById('faqSearchStatus');

  function setOpen(item: HTMLElement, open: boolean) {
    item.classList.toggle('active', open);
    item
      .querySelector<HTMLButtonElement>('.hdt-faq-question-btn')
      ?.setAttribute('aria-expanded', String(open));
  }

  function filter() {
    if (!search) return;
    const term = search.value.trim().toLowerCase();
    let matches = 0;

    for (const item of items) {
      if (!term) {
        item.hidden = false;
        setOpen(item, false);
        continue;
      }
      const question = item.querySelector('.hdt-faq-question')?.textContent?.toLowerCase() ?? '';
      const answer =
        item.querySelector('.hdt-faq-answer-content')?.textContent?.toLowerCase() ?? '';
      const hit = question.includes(term) || answer.includes(term);
      item.hidden = !hit;
      if (hit) {
        matches += 1;
        setOpen(item, term.length > 2);
      } else {
        setOpen(item, false);
      }
    }

    if (status) {
      status.textContent = term
        ? `${matches} ${matches === 1 ? 'question matches' : 'questions match'} "${search.value.trim()}".`
        : '';
    }
  }

  search?.addEventListener('input', filter);
  button?.addEventListener('click', filter);
  search?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      filter();
    }
  });
</script>

