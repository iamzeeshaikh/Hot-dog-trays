---
import { Image } from 'astro:assets';
import imgBestpaperhotdogtrays from '../../assets/products/Best-paper-hot-dog-trays.jpg';
import imgHotDogFoodTrayWithHolderPlastic from '../../assets/products/Hot-Dog-Food-Tray-With-Holder-Plastic.jpg';
import imgHotDogPaperHoldersInBulk from '../../assets/products/Hot-Dog-Paper-Holders-In-Bulk.jpg';
import imgHotdogservingtraywholesale from '../../assets/products/Hot-dog-serving-tray-wholesale.jpg';
---

<section class="hdt-featured">
    <div class="hdt-featured-container">
        <div class="hdt-featured-header">
            <div class="hdt-featured-badge">Best Sellers</div>
            <h2 class="hdt-featured-title">Featured Hot Dog Trays</h2>
            <p class="hdt-featured-subtitle">
                Premium quality disposable hot dog trays perfect for food trucks, stadiums, and events
            </p>
        </div>
        <div class="hdt-products-grid">
            <div class="hdt-product-card">
                <div class="hdt-product-badge">Best Seller</div>
                <div class="hdt-product-image">
                    <Image src={imgHotdogservingtraywholesale} alt="Hot Dog Serving Tray" widths={[400, 800]} sizes="(max-width: 768px) 92vw, (max-width: 1200px) 45vw, 320px" loading="lazy" decoding="async" />
                </div>
                <div class="hdt-product-content">
                    <h3 class="hdt-product-title">Hot Dog Serving Tray</h3>
                    <p class="hdt-product-description">
                        Premium kraft paper serving trays with sturdy construction
                    </p>
                    <div class="hdt-product-features">
                        <span class="hdt-product-feature">Eco-Friendly</span>
                        <span class="hdt-product-feature">Recyclable</span>
                        <span class="hdt-product-feature">Custom Print</span>
                    </div>
                    <div class="hdt-product-footer">
                        <div class="hdt-product-price">
                            <span class="hdt-price-label">Starting at</span>
                            <span class="hdt-price-amount">$0.50<span class="hdt-price-unit">USD</span></span>
                        </div>
                        <a href="/product/hot-dog-serving-tray/" class="hdt-product-btn">
                            View Product →
                        </a>
                    </div>
                </div>
            </div>
            <div class="hdt-product-card">
                <div class="hdt-product-badge">Popular</div>
                <div class="hdt-product-image">
                    <Image src={imgHotDogFoodTrayWithHolderPlastic} alt="Hot Dog Food Tray" widths={[400, 800]} sizes="(max-width: 768px) 92vw, (max-width: 1200px) 45vw, 320px" loading="lazy" decoding="async" />
                </div>
                <div class="hdt-product-content">
                    <h3 class="hdt-product-title">Hot Dog Food Tray</h3>
                    <p class="hdt-product-description">
                        Durable food-grade trays with grease-resistant coating
                    </p>
                    <div class="hdt-product-features">
                        <span class="hdt-product-feature">Grease Resistant</span>
                        <span class="hdt-product-feature">Food-Grade</span>
                        <span class="hdt-product-feature">Microwave Safe</span>
                    </div>
                    <div class="hdt-product-footer">
                        <div class="hdt-product-price">
                            <span class="hdt-price-label">Starting at</span>
                            <span class="hdt-price-amount">$0.50<span class="hdt-price-unit">USD</span></span>
                        </div>
                        <a href="/product/hot-dog-food-tray/" class="hdt-product-btn">
                            View Product →
                        </a>
                    </div>
                </div>
            </div>
            <div class="hdt-product-card">
                <div class="hdt-product-badge">Trending</div>
                <div class="hdt-product-image">
                    <Image src={imgBestpaperhotdogtrays} alt="Paper Hot Dog Trays" widths={[400, 800]} sizes="(max-width: 768px) 92vw, (max-width: 1200px) 45vw, 320px" loading="lazy" decoding="async" />
                </div>
                <div class="hdt-product-content">
                    <h3 class="hdt-product-title">Paper Hot Dog Trays</h3>
                    <p class="hdt-product-description">
                        Classic paper trays perfect for events and festivals
                    </p>
                    <div class="hdt-product-features">
                        <span class="hdt-product-feature">Lightweight</span>
                        <span class="hdt-product-feature">Disposable</span>
                        <span class="hdt-product-feature">Bulk Pricing</span>
                    </div>
                    <div class="hdt-product-footer">
                        <div class="hdt-product-price">
                            <span class="hdt-price-label">Starting at</span>
                            <span class="hdt-price-amount">$0.50<span class="hdt-price-unit">USD</span></span>
                        </div>
                        <a href="/product/paper-hot-dog-trays/" class="hdt-product-btn">
                            View Product →
                        </a>
                    </div>
                </div>
            </div>
            <div class="hdt-product-card">
                <div class="hdt-product-badge">New</div>
                <div class="hdt-product-image">
                    <Image src={imgHotDogPaperHoldersInBulk} alt="Hot Dog Holders" widths={[400, 800]} sizes="(max-width: 768px) 92vw, (max-width: 1200px) 45vw, 320px" loading="lazy" decoding="async" />
                </div>
                <div class="hdt-product-content">
                    <h3 class="hdt-product-title">Hot Dog Holders</h3>
                    <p class="hdt-product-description">
                        Convenient holders for easy serving and eating
                    </p>
                    <div class="hdt-product-features">
                        <span class="hdt-product-feature">Easy Grip</span>
                        <span class="hdt-product-feature">Heat Safe</span>
                        <span class="hdt-product-feature">Customizable</span>
                    </div>
                    <div class="hdt-product-footer">
                        <div class="hdt-product-price">
                            <span class="hdt-price-label">Starting at</span>
                            <span class="hdt-price-amount">$0.50<span class="hdt-price-unit">USD</span></span>
                        </div>
                        <a href="/product/hot-dog-paper-holders/" class="hdt-product-btn">
                            View Product →
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="hdt-view-all">
            <a href="/shop/" class="hdt-view-all-btn">
                View All Products →
            </a>
        </div>
    </div>
</section>

<style>
/* Migrated from the Elementor "FeaturedProducts" HTML widget. */
/* Force everything clickable */
.hdt-featured,
.hdt-featured * {
    pointer-events: auto !important;
}

.hdt-featured a,
.hdt-featured button {
    cursor: pointer !important;
}

/* Featured Products Section */
.hdt-featured {
    background: linear-gradient(180deg, #F1FAEE 0%, #FFFFFF 100%);
    padding: 80px 0;
}

.hdt-featured-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Section Header */
.hdt-featured-header {
    text-align: center;
    margin-bottom: 60px;
}

.hdt-featured-badge {
    display: inline-block;
    background: linear-gradient(135deg, #F9C74F, #E63946);
    color: #1D3557;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.hdt-featured-title {
    font-size: 2.8rem;
    font-weight: 900;
    color: #1D3557;
    margin-bottom: 15px;
    line-height: 1.2;
}

.hdt-featured-subtitle {
    font-size: 1.1rem;
    color: #666;
    max-width: 600px;
    margin: 0 auto;
}

/* Products Grid */
.hdt-products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
}

/* Product Card */
.hdt-product-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    position: relative;
}

.hdt-product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(230, 57, 70, 0.2);
}

/* Product Badge */
.hdt-product-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: linear-gradient(135deg, #E63946, #F9C74F);
    color: white;
    padding: 6px 15px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    z-index: 2;
    box-shadow: 0 5px 15px rgba(230, 57, 70, 0.4);
}

/* Product Image */
.hdt-product-image {
    width: 100%;
    height: 240px;
    overflow: hidden;
    background: linear-gradient(135deg, #F1FAEE, #FFFFFF);
    position: relative;
}

.hdt-product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.hdt-product-card:hover .hdt-product-image img {
    transform: scale(1.1);
}

/* Product Content */
.hdt-product-content {
    padding: 25px 20px;
}

.hdt-product-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #1D3557;
    margin-bottom: 10px;
    line-height: 1.3;
    min-height: 45px;
}

.hdt-product-description {
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 15px;
    line-height: 1.5;
    min-height: 40px;
}

/* Product Features */
.hdt-product-features {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 15px;
}

.hdt-product-feature {
    font-size: 0.75rem;
    background: rgba(249, 199, 79, 0.1);
    color: #1D3557;
    padding: 4px 10px;
    border-radius: 15px;
    font-weight: 600;
}

/* Product Price & Button */
.hdt-product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 15px;
    border-top: 2px solid #F1FAEE;
}

.hdt-product-price {
    display: flex;
    flex-direction: column;
}

.hdt-price-label {
    font-size: 0.7rem;
    color: #666;
    text-transform: uppercase;
    margin-bottom: 2px;
}

.hdt-price-amount {
    font-size: 1.8rem;
    font-weight: 900;
    color: #E63946;
    line-height: 1;
}

.hdt-price-unit {
    font-size: 0.8rem;
    color: #666;
    font-weight: 600;
}

.hdt-product-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #1D3557, #E63946);
    color: white;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.85rem;
    transition: all 0.3s ease;
    text-transform: uppercase;
    box-shadow: 0 5px 15px rgba(29, 53, 87, 0.3);
}

.hdt-product-btn:hover {
    background: linear-gradient(135deg, #E63946, #F9C74F);
    transform: translateX(5px);
    color: white;
}

/* View All Button */
.hdt-view-all {
    text-align: center;
    margin-top: 50px;
}

.hdt-view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 40px;
    background: linear-gradient(135deg, #F9C74F, #E63946);
    color: #1D3557;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 800;
    font-size: 1.1rem;
    text-transform: uppercase;
    transition: all 0.3s ease;
    box-shadow: 0 8px 25px rgba(249, 199, 79, 0.4);
}

.hdt-view-all-btn:hover {
    background: linear-gradient(135deg, #E63946, #1D3557);
    color: white;
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(230, 57, 70, 0.5);
}

/* Responsive Design */
@media (max-width: 1024px) {
    .hdt-products-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
    }
}

@media (max-width: 768px) {
    .hdt-featured {
        padding: 60px 0;
    }
    
    .hdt-featured-title {
        font-size: 2.2rem;
    }
    
    .hdt-products-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }
    
    .hdt-product-image {
        height: 200px;
    }
}

@media (max-width: 480px) {
    .hdt-featured-title {
        font-size: 1.8rem;
    }
    
    .hdt-product-content {
        padding: 20px 15px;
    }
    
    .hdt-product-footer {
        flex-direction: column;
        gap: 15px;
        align-items: flex-start;
    }
    
    .hdt-product-btn {
        width: 100%;
        justify-content: center;
    }
}

/* Performance Optimization */
@media (prefers-reduced-motion: reduce) {
    .hdt-product-card,
    .hdt-product-image img,
    .hdt-product-btn,
    .hdt-view-all-btn {
        transition: none !important;
    }
}
</style>
