---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { productsAlphabetical } from '../data/products';
import { graph, organization, website, breadcrumbs, collectionPage } from '../lib/schema';

const path = '/shop/';
// Metadata inherited from /product-category/products/, the stronger of the two
// archives WooCommerce produced, which is now 301'd here.
const title = 'Custom Hot Dog Trays | Wholesale Paper, Cardboard & Kraft';
const description =
  'Shop wholesale hot dog trays in paper, cardboard, kraft and plastic. Custom sizes, custom printing and bulk pricing.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Shop', url: path },
];

const schema = graph([
  organization(),
  website(),
  ...collectionPage(path, 'Shop', description, productsAlphabetical),
  breadcrumbs(path, crumbs),
]);
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="hdt-archive">
    <h1 class="hdt-archive-title">Shop</h1>
    <p class="hdt-archive-count">Showing all {productsAlphabetical.length} results</p>
    <ProductGrid products={productsAlphabetical} label="All products" />
  </div>
</BaseLayout>

<style is:global>
  .hdt-archive {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px 20px 70px;
  }

  .hdt-archive-title {
    margin: 10px 0 6px;
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 900;
    color: #1d3557;
  }

  .hdt-archive-intro {
    max-width: 780px;
    margin: 0 0 6px;
    color: #555;
    line-height: 1.7;
  }

  .hdt-archive-count {
    margin: 0 0 28px;
    /* #777 is 4.48:1 on white, a hair under AA */
    color: #666;
    font-size: 0.9rem;
  }
</style>
