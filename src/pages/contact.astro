---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ContactContent from '../components/pages/ContactContent.astro';
import { graph, organization, website, webPage, breadcrumbs, faqPage } from '../lib/schema';
import PageExtras from '../components/PageExtras.astro';
import { pageExtras } from '../data/page-extras';

const path = '/contact/';
const title = pageExtras['contact'].title;
const description = pageExtras['contact'].description;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: path },
];

const schema = graph([
  organization(),
  website(),
  webPage(path, title, description, 'ContactPage'),
  breadcrumbs(path, crumbs),
  ...(pageExtras['contact'].faqs.length ? [faqPage(path, pageExtras['contact'].faqs)] : []),
]);
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <ContactContent />
  <PageExtras extra={pageExtras['contact']} id="contact" />
  <QuoteBlock headingId="contact-quote-heading">
    <QuoteForm idPrefix="contact-quote" />
  </QuoteBlock>
</BaseLayout>
