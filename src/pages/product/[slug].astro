---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductInquiryForm from '../../components/ProductInquiryForm.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import ProductTabs from '../../components/ProductTabs.astro';

import Features from '../../components/product/Features.astro';
import MaterialOptions from '../../components/product/MaterialOptions.astro';
import Customization from '../../components/product/Customization.astro';
import SizeGuide from '../../components/product/SizeGuide.astro';
import OrderProcess from '../../components/product/OrderProcess.astro';
import ProductUseCases from '../../components/product/ProductUseCases.astro';
import ProductFaqSection from '../../components/product/ProductFaqSection.astro';
import Guarantee from '../../components/product/Guarantee.astro';

import { products, getRelated, startingPrice, type Product } from '../../data/products';
import { CATEGORY } from '../../data/site';
import { SHIPPING, shippingCountriesSentence, shippingWindow } from '../../data/shipping';
import { productPageFaqs } from '../../data/page-faqs';
import { productSeo } from '../../data/product-seo';
import {
  graph,
  organization,
  website,
  breadcrumbs,
  faqPage,
  product as productSchema,
} from '../../lib/schema';

import payments from '../../assets/site/payments.png';
import paymentImage from '../../assets/site/payment-image.jpeg';
import dmca from '../../assets/site/dmca-badge-w250-2x1-01.png';
import secureIcons from '../../assets/site/secure-icons.png';
import guaranteeImage from '../../assets/site/guarantee_image.webp';

export const getStaticPaths = (() =>
  products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }))) satisfies GetStaticPaths;

interface Props {
  product: Product;
}

const { product } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/products/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const galleryUrls = product.images
  .map((i) => files[`/src/assets/products/${i.file}`]?.default.src)
  .filter((s): s is string => Boolean(s));

const price = startingPrice(product);
const related = getRelated(product);

// Per-product metadata overrides and guide cross-links. Falls back to the
// migrated Yoast values where no override is defined.
const seo = productSeo[product.slug];
const metaTitle = seo?.title ?? product.metaTitle;
const metaDescription = seo?.description ?? product.metaDescription;
const guideLinks = seo?.guides ?? [];

const crumbs = [
  { name: 'Home', url: '/' },
  { name: CATEGORY.name, url: CATEGORY.url },
  { name: product.name, url: product.url },
];

// One FAQPage node covering every question visible on the page: the
// product-specific set from WooCommerce plus the shared ordering FAQs below it.
const seen = new Set<string>();
const visibleFaqs = [...product.faqs, ...productPageFaqs].filter((f) => {
  const key = f.question.trim().toLowerCase();
  if (seen.has(key)) return false;
  seen.add(key);
  return true;
});

const schema = graph([
  organization(),
  website(),
  productSchema(product, galleryUrls),
  breadcrumbs(product.url, crumbs),
  faqPage(product.url, visibleFaqs),
]);
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  path={product.url}
  ogType="product"
  ogImage={galleryUrls[0]}
  schema={schema}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="hdt-product-hero">
    <div class="hdt-product-hero-inner">
      <div class="hdt-product-heading">
        <span class="hdt-product-eyebrow">
          <i class="fas fa-box-open" aria-hidden="true"></i> Custom Wholesale Packaging
        </span>
        <h1 class="hdt-product-title">{product.name}</h1>
      </div>

      <div class="hdt-product-layout">
        <div class="hdt-product-summary">
          <div class="hdt-product-short" set:html={product.shortDescription} />

          <dl class="hdt-product-meta">
            {
              price && (
                <div class="hdt-meta-row hdt-meta-price">
                  <dt>Starting price</dt>
                  <dd>
                    <span class="hdt-price-value">${price}</span>
                    <span class="hdt-price-currency">USD</span>
                  </dd>
                </div>
              )
            }
            <div class="hdt-meta-row">
              <dt>Availability</dt>
              <dd>
                <span class="hdt-stock">
                  <i class="fas fa-circle-check" aria-hidden="true" />
                  {product.inStock ? 'In stock — made to order' : 'Currently unavailable'}
                </span>
              </dd>
            </div>
            <div class="hdt-meta-row">
              <dt>SKU</dt>
              <dd>{product.sku}</dd>
            </div>
            <div class="hdt-meta-row">
              <dt>Category</dt>
              <dd><a href={CATEGORY.url}>{product.category}</a></dd>
            </div>
          </dl>

          <ul class="hdt-product-usps">
            <li><i class="fas fa-pen-ruler" aria-hidden="true" /> Free custom design</li>
            <li><i class="fas fa-leaf" aria-hidden="true" /> Food-safe &amp; recyclable</li>
            <li><i class="fas fa-truck-fast" aria-hidden="true" /> Fast worldwide shipping</li>
            <li><i class="fas fa-layer-group" aria-hidden="true" /> Low minimums, bulk pricing</li>
          </ul>

          <a href="#inquiry-form" class="hdt-product-cta">
            Get Free Quote
            <i class="fas fa-arrow-right" aria-hidden="true" />
          </a>
        </div>

        <div class="hdt-product-form" id="inquiry-form">
          <ProductInquiryForm productName={product.name} />
        </div>

        <div class="hdt-product-media">
          <ProductGallery images={product.images} productName={product.name} />
        </div>
      </div>

      <div class="hdt-trust-badges">
        <Image src={paymentImage} alt="Accepted payment methods" loading="lazy" densities={[1]} />
        <Image src={payments} alt="Card payment providers" loading="lazy" densities={[1]} />
        <Image src={dmca} alt="DMCA protected" loading="lazy" densities={[1]} />
        <Image src={secureIcons} alt="Secure checkout and SSL protection" loading="lazy" densities={[1]} />
        <Image src={guaranteeImage} alt="Satisfaction guarantee" loading="lazy" densities={[1]} />
      </div>
    </div>
  </section>

  {
    guideLinks.length > 0 && (
      <section class="hdt-product-guides" aria-labelledby="product-guides-heading">
        <div class="hdt-product-guides-inner">
          <h2 id="product-guides-heading">Before you order</h2>
          {guideLinks.map((g) => (
            <p>
              {g.lead} <a href={g.href}>{g.anchor}</a>.
            </p>
          ))}
        </div>
      </section>
    )
  }

  <ProductTabs
    description={product.description}
    spec={product.specifications}
    faqs={product.faqs}
    productName={product.name}
  />

  <Features />
  <MaterialOptions />
  <Customization />
  <SizeGuide />
  <OrderProcess />
  <ProductUseCases />
  <ProductFaqSection />
  <Guarantee />

  <RelatedProducts products={related} />
</BaseLayout>

<style is:global>
  .hdt-product-hero {
    padding: 8px 20px 50px;
    background:
      radial-gradient(900px 320px at 12% 0%, rgb(249 199 79 / 13%), transparent 70%),
      radial-gradient(760px 300px at 88% 8%, rgb(230 57 70 / 9%), transparent 70%),
      #fff;
  }

  .hdt-product-hero-inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* --- heading ---------------------------------------------------------- */
  .hdt-product-heading {
    text-align: center;
    margin-bottom: 34px;
  }

  .hdt-product-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: 50px;
    background: rgb(29 53 87 / 6%);
    color: #1d3557;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .hdt-product-eyebrow i {
    color: #e63946;
  }

  .hdt-product-title {
    margin: 14px 0 0;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    font-weight: 900;
    color: #1d3557;
    line-height: 1.15;
  }

  .hdt-product-title::after {
    content: '';
    display: block;
    width: 74px;
    height: 4px;
    margin: 16px auto 0;
    border-radius: 2px;
    background: linear-gradient(90deg, #f9c74f, #e63946);
  }

  /* --- layout ----------------------------------------------------------- */
  .hdt-product-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.95fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }

  /* --- summary ---------------------------------------------------------- */
  .hdt-product-short {
    color: #4a5568;
    line-height: 1.75;
    font-size: 0.97rem;
  }

  .hdt-product-short p {
    margin: 0 0 14px;
  }

  .hdt-product-short strong {
    color: #1d3557;
  }

  .hdt-product-meta {
    margin: 22px 0;
    padding: 6px 20px;
    background: #fff;
    border: 1px solid #efefef;
    border-radius: 14px;
    box-shadow: 0 6px 18px rgb(29 53 87 / 5%);
    font-size: 0.92rem;
  }

  .hdt-meta-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid #f2f2f2;
  }

  .hdt-meta-row:last-child {
    border-bottom: none;
  }

  .hdt-meta-row dt {
    font-weight: 700;
    /* #7a8699 was 3.69:1 on white, below AA for this size */
    color: #66707f;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .hdt-meta-row dd {
    margin: 0;
    color: #1d3557;
    font-weight: 600;
    text-align: right;
  }

  .hdt-meta-price dd {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .hdt-price-value {
    font-size: 1.5rem;
    font-weight: 900;
    color: #e63946;
    line-height: 1;
  }

  .hdt-price-currency {
    font-size: 0.74rem;
    font-weight: 800;
    color: #66707f;
    letter-spacing: 0.06em;
  }

  .hdt-stock {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hdt-stock i {
    color: #2a9d8f;
  }

  .hdt-product-meta dd a {
    display: inline-block;
    padding: 3px 0;
    color: #c92a35;
    font-weight: 700;
  }

  /* --- selling points --------------------------------------------------- */
  .hdt-product-usps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 14px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
  }

  .hdt-product-usps li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #4a5568;
  }

  .hdt-product-usps i {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: rgb(249 199 79 / 20%);
    color: #e63946;
    font-size: 0.78rem;
  }

  /* --- cta -------------------------------------------------------------- */
  .hdt-product-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 15px 26px;
    background: linear-gradient(135deg, #f9c74f, #e63946);
    color: #1d3557;
    border-radius: 50px;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 8px 22px rgb(230 57 70 / 26%);
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }

  .hdt-product-cta i {
    transition: transform 0.25s;
  }

  .hdt-product-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgb(230 57 70 / 36%);
  }

  .hdt-product-cta:hover i {
    transform: translateX(4px);
  }

  /* --- trust badges ----------------------------------------------------- */
  .hdt-product-guides {
    padding: 44px 20px 4px;
    background: #fff;
  }

  .hdt-product-guides-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 28px;
    border-left: 4px solid #f9c74f;
    background: #fffaf0;
    border-radius: 0 12px 12px 0;
  }

  .hdt-product-guides-inner h2 {
    margin: 0 0 12px;
    font-size: 1.15rem;
    font-weight: 800;
    color: #1d3557;
  }

  .hdt-product-guides-inner p {
    margin: 0 0 10px;
    color: #4a5568;
    line-height: 1.7;
  }

  .hdt-product-guides-inner p:last-child {
    margin-bottom: 0;
  }

  .hdt-product-guides-inner a {
    color: #c92a35;
    font-weight: 700;
  }

  .hdt-trust-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 30px;
    margin-top: 46px;
    padding-top: 32px;
    border-top: 1px solid #ededed;
  }

  .hdt-trust-badges img {
    max-height: 74px;
    width: auto;
    filter: grayscale(0.25);
    opacity: 0.9;
    transition:
      filter 0.3s,
      opacity 0.3s;
  }

  .hdt-trust-badges img:hover {
    filter: none;
    opacity: 1;
  }

  /* --- responsive ------------------------------------------------------- */
  @media (max-width: 1100px) {
    .hdt-product-layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* gallery beside the copy, form on its own full-width row */
    .hdt-product-media {
      order: -1;
    }

    .hdt-product-form {
      grid-column: 1 / -1;
      max-width: 620px;
      margin: 0 auto;
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .hdt-product-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
    }

    .hdt-product-form {
      max-width: none;
    }

    .hdt-product-usps {
      grid-template-columns: minmax(0, 1fr);
    }

    .hdt-product-guides {
    padding: 44px 20px 4px;
    background: #fff;
  }

  .hdt-product-guides-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 28px;
    border-left: 4px solid #f9c74f;
    background: #fffaf0;
    border-radius: 0 12px 12px 0;
  }

  .hdt-product-guides-inner h2 {
    margin: 0 0 12px;
    font-size: 1.15rem;
    font-weight: 800;
    color: #1d3557;
  }

  .hdt-product-guides-inner p {
    margin: 0 0 10px;
    color: #4a5568;
    line-height: 1.7;
  }

  .hdt-product-guides-inner p:last-child {
    margin-bottom: 0;
  }

  .hdt-product-guides-inner a {
    color: #c92a35;
    font-weight: 700;
  }

  .hdt-trust-badges {
      gap: 20px;
      margin-top: 34px;
    }

    .hdt-trust-badges img {
      max-height: 54px;
    }
  }
</style>
