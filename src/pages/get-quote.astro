---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import QuoteForm from '../components/QuoteForm.astro';
import QuoteHero from '../components/pages/QuoteHero.astro';
import QuoteProcess from '../components/pages/QuoteProcess.astro';
import QuoteInfo from '../components/pages/QuoteInfo.astro';
import QuotePricing from '../components/pages/QuotePricing.astro';
import QuoteCta from '../components/pages/QuoteCta.astro';
import { graph, organization, website, webPage, breadcrumbs, faqPage } from '../lib/schema';
import PageExtras from '../components/PageExtras.astro';
import { pageExtras } from '../data/page-extras';

const path = '/get-quote/';
const title = pageExtras['get-quote'].title;
const description = pageExtras['get-quote'].description;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Get Quote', url: path },
];

const schema = graph([
  organization(),
  website(),
  webPage(path, title, description),
  breadcrumbs(path, crumbs),
  ...(pageExtras['get-quote'].faqs.length ? [faqPage(path, pageExtras['get-quote'].faqs)] : []),
]);
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <QuoteHero />
  <QuoteBlock headingId="get-quote-heading">
    <QuoteForm idPrefix="get-quote" />
  </QuoteBlock>
  <QuoteProcess />
  <PageExtras extra={pageExtras['get-quote']} id="get-quote" />
  <QuoteInfo />
  <QuotePricing />
  <QuoteCta />
</BaseLayout>
