---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import QuoteBlock from '../components/QuoteBlock.astro';

import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import FeaturedProducts from '../components/home/FeaturedProducts.astro';
import ChooseFormat from '../components/home/ChooseFormat.astro';
import Categories from '../components/home/Categories.astro';
import WhyChoose from '../components/home/WhyChoose.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Materials from '../components/home/Materials.astro';
import UseCases from '../components/home/UseCases.astro';
import CtaBanner from '../components/home/CtaBanner.astro';
import HomeFaq from '../components/home/HomeFaq.astro';

import { graph, organization, website, webPage, breadcrumbs, faqPage } from '../lib/schema';
import { homeFaqs } from '../data/page-faqs';
import ogImage from '../assets/products/Hot-dog-serving-tray-wholesale.jpg';

const path = '/';
/*
 * Title keeps the Yoast wording that already ranks for the head term and adds
 * the wholesale intent the query cluster shows. The old description ended on an
 * unsupported free-shipping claim, so it was rewritten around what the business
 * genuinely offers.
 */
const title = 'Custom Hot Dog Trays | Wholesale & Printed | Hot Dog Trays';
const description =
  'Custom hot dog trays in wholesale quantities. Paper, kraft, cardboard and plastic, printed with your branding in your own sizes.';

const schema = graph([
  organization(),
  website(),
  webPage(path, title, description),
  breadcrumbs(path, [{ name: 'Home', url: '/' }]),
  faqPage(path, homeFaqs),
]);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogImage={ogImage.src}
  schema={schema}
>
  <Hero />
  <TrustBar />
  <FeaturedProducts />
  <ChooseFormat />
  <Categories />
  <WhyChoose />
  <HowItWorks />
  <Materials />
  <UseCases />

  <QuoteBlock headingId="home-quote-heading">
    <QuoteForm idPrefix="home-quote" />
  </QuoteBlock>

  <CtaBanner />
  <HomeFaq />
</BaseLayout>
