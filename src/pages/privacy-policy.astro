---
import PolicyLayout from '../layouts/PolicyLayout.astro';
import body from '../content/pages/privacy-policy.html?raw';
import { extraFaqs } from '../data/page-extras';

const extra = { title: '', description: '', sections: [], faqs: extraFaqs('privacy-policy') };
---

<PolicyLayout
  title="Privacy Policy - Hot Dog Trays"
  description="How HotDogTrays.com collects, uses, protects and discloses information when you visit or interact with our website."
  heading="Privacy Policy"
  path="/privacy-policy/"
  body={body}
  extra={extra}
/>
