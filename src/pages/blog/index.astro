---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbs } from '../../lib/schema';
import { BLOG_POSTS } from '../../lib/blog';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
];

const fmt = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---
<BaseLayout
  title="Blog | HotDogTrays.com"
  description="Guides on paper hot dog boats, custom printed trays and grease resistant packaging for food trucks, stands and restaurants."
  path="/blog/"
  schema={breadcrumbs('/blog/', crumbs)}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="hdt-container blog-wrap">
    <h1>Hot Dog Packaging Blog</h1>
    <p class="blog-lead">
      Practical reading on paper boats, custom printed trays and grease control for busy food service counters.
    </p>
    <div class="blog-grid">
      {
        BLOG_POSTS.map((post, i) => (
          <article class="blog-card">
            <a href={post.url}>
              <img
                src={post.image}
                alt={post.imageAlt}
                width={post.imageWidth}
                height={post.imageHeight}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
            <div class="blog-card-body">
              <p class="blog-date">{fmt(post.date)}</p>
              <h2><a href={post.url}>{post.title}</a></h2>
              <p class="blog-excerpt">{post.metaDescription}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .blog-wrap { padding: 32px 16px 56px; max-width: 1100px; margin: 0 auto; }
  .blog-lead { color: #666; max-width: 640px; margin: 8px 0 28px; }
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 26px; }
  .blog-card { border: 1px solid #e5ded2; border-radius: 10px; overflow: hidden; background: #fff; }
  .blog-card img { display: block; width: 100%; height: auto; }
  .blog-card-body { padding: 16px 18px 20px; }
  .blog-date { font-size: .8rem; color: #8a7a63; margin: 0 0 6px; }
  .blog-card-body h2 { font-size: 1.08rem; line-height: 1.35; margin: 0 0 8px; }
  .blog-card-body h2 a { color: inherit; text-decoration: none; }
  .blog-card-body h2 a:hover { text-decoration: underline; }
  .blog-excerpt { font-size: .9rem; color: #666; margin: 0; }
</style>
