---
import BaseLayout from '../../layouts/BaseLayout.astro';

/*
 * The WooCommerce account area has no equivalent in the quotation-led site, so
 * this URL reports 410 Gone rather than being redirected somewhere irrelevant.
 * It is excluded from the sitemap and marked noindex.
 */
export const prerender = false;

Astro.response.status = 410;
Astro.response.headers.set('Cache-Control', 'public, max-age=3600');
---

<BaseLayout title="Page no longer available - Hot Dog Trays" path="/my-account/" noindex>
  <div class="hdt-gone">
    <h1>Customer accounts have been retired</h1>
    <p>
      Hot Dog Trays now works entirely on custom quotations, so there is no account area. Tell us
      what you need and we'll send pricing within two business hours.
    </p>
    <p>
      <a class="hdt-gone-cta" href="/get-quote/">Request a free quote</a>
    </p>
    <p class="hdt-gone-alt">
      Prefer to talk? Call <a href="tel:5033580443">(503) 358-0443</a> or email
      <a href="mailto:info@hotdogtrays.com">info@hotdogtrays.com</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .hdt-gone {
    max-width: 680px;
    margin: 0 auto;
    padding: 80px 20px 100px;
    text-align: center;
  }

  .hdt-gone h1 {
    margin: 0 0 16px;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 900;
    color: #1d3557;
  }

  .hdt-gone p {
    margin: 0 0 18px;
    color: #555;
    line-height: 1.7;
  }

  .hdt-gone-cta {
    display: inline-block;
    margin-top: 8px;
    padding: 13px 30px;
    background: linear-gradient(135deg, #f9c74f, #e63946);
    color: #1d3557;
    border-radius: 50px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hdt-gone-alt a {
    color: #e63946;
    font-weight: 700;
  }
</style>
