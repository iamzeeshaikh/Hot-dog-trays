---
import PolicyLayout from '../layouts/PolicyLayout.astro';
import body from '../content/pages/terms-conditions.html?raw';
import { extraFaqs } from '../data/page-extras';

const extra = { title: '', description: '', sections: [], faqs: extraFaqs('terms-conditions') };
---

<PolicyLayout
  title="Terms Conditions - Hot Dog Trays"
  description="The terms and conditions that govern your use of HotDogTrays.com, our products, orders, payments and services."
  heading="Terms Conditions"
  path="/terms-conditions/"
  body={body}
  extra={extra}
/>
